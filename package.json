{
  "name": "dara",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:dev": "npm run build:dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web -- --outDir ../../dist --emptyOutDir",
    "build:all": "npm run db:generate && npm run build --workspace=apps/web && npm run build --workspace=apps/api",
    "start": "npm run start --workspace=apps/api",
    "test": "npm run test --workspaces --if-present && npm run test:legacy",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "test:legacy": "node --test validators.test.js server.test.js assets-core.test.js apps/web/public/legacy/phase4-core.test.js apps/web/public/legacy/phase5-core.test.js",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:validate": "npm run db:validate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.2.1"
  }
}
