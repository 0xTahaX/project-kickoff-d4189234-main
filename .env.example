# API runtime configuration. The Vite development server runs separately.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
DATABASE_POOL_MAX=5
# Optional absolute path to the official Supabase CA certificate; keep the file outside the repository.
DATABASE_SSL_CA_FILE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set this after provisioning PostgreSQL.
DATABASE_URL=postgresql://dara:dara@localhost:5432/dara?schema=public
