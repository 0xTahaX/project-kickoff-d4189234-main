# ─────────────────────────────────────────────────────────────────────────────
# API runtime
# ─────────────────────────────────────────────────────────────────────────────
# development | test | production
# REQUIRED in production (set to "production"). Enables secure cookies, HSTS and trust proxy.
# Locally leave as development.
NODE_ENV=development
# API port. REQUIRED locally (default 3001). On Render leave unset: Render injects PORT.
PORT=3001
# Browser origin allowed to send mutations (CSRF guard).
# OPTIONAL: when empty, APP_URL / RENDER_EXTERNAL_URL is used. Leave empty on Render.
WEB_ORIGIN=http://localhost:5173
# Public base URL used in password-reset e-mail links.
# OPTIONAL: when empty, RENDER_EXTERNAL_URL is used. Leave empty on Render.
APP_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. REQUIRED in production.
# Local:    postgresql://postgres:<your-password>@localhost:5432/dara?schema=public
# Supabase: Dashboard → Project Settings → Database → Connection string → Session pooler
# Never commit the version of this file that contains a real password.
DATABASE_URL=postgresql://dara:dara@localhost:5432/dara?schema=public
# Maximum pool connections per process (1–20). OPTIONAL, default 5.
# Lower it when the database plan limits concurrent connections.
DATABASE_POOL_MAX=5
# Absolute path to the Supabase CA certificate. Needed only for *.supabase.com hosts.
# OPTIONAL locally, REQUIRED for Supabase. Get it from:
# Supabase → Project Settings → Database → SSL Configuration → Download certificate
# Keep the file outside the repository. On Render upload it as a Secret File, e.g.
# /etc/secrets/supabase-prod-ca-2021.crt and set this variable to that path.
DATABASE_SSL_CA_FILE=

# ─────────────────────────────────────────────────────────────────────────────
# E-mail (OPTIONAL — only needed for "forgot password")
# ─────────────────────────────────────────────────────────────────────────────
# Username sign-up and login never need e-mail. If no transport is configured, the
# password-reset endpoint answers with an explicit EMAIL_NOT_CONFIGURED error.
#
# Option A (RECOMMENDED on Render Free): Brevo HTTPS API.
#   Render Free blocks outbound SMTP ports 25/465/587, so SMTP cannot work there.
#   1. Create a free Brevo account (no card): https://www.brevo.com
#   2. Senders & IPs → Senders → Add a sender, use any address you own (no domain needed)
#      and confirm the verification e-mail Brevo sends.
#   3. SMTP & API → API keys → Create a new API key.
#   4. Put the key here and set MAIL_FROM to the verified sender address.
#   Free plan: 300 e-mails/day, "Sent with Brevo" footer, no time limit.
BREVO_API_KEY=
MAIL_FROM=
#
# Option B (local development, or hosts that allow SMTP): classic SMTP.
#   Gmail example: smtp.gmail.com:587 with an App Password (needs 2-Step Verification).
#   MAIL_FROM falls back to SMTP_FROM when it is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
